;; CPU backend implementation of the virtual [deepseek] library.
;;
;; Same vendored ../csrc core as the Metal variant, but ds4.c is compiled with
;; -DDS4_NO_GPU (the upstream CPU executor) and there is no GPU backend object
;; and no framework link flags. Mirrors the upstream Makefile `cpu` target's
;; CPU_CORE_OBJS = ds4_cpu.o ds4_distributed.o ds4_ssd.o.
;;
;; Compile flags come from ../config/core_cflags, written by discover.ml, so this
;; builds on both macOS (-mcpu=native) and Linux/x86 (-march=native plus the GNU
;; / finite-math knobs) from the same rules.

(library
 (name deepseek_cpu)
 (public_name deepseek.cpu)
 (implements deepseek)
 (modes native)
 (modules backend)
 (foreign_archives ds4_core_cpu)
 (foreign_stubs
  (language c)
  (names ds4_stubs)
  (include_dirs ../csrc))
 (c_library_flags
  (-lm -pthread)))

;; The shared, backend-agnostic FFI stub, compiled into this implementation.

(copy_files ../csrc/ds4_stubs.c)

;; --- Engine archive: CPU core objects only (no GPU backend object). ---

(rule
 (target ds4_cpu.o)
 (deps
  ../csrc/ds4.c
  ../csrc/ds4.h
  ../csrc/ds4_ssd.h
  ../csrc/ds4_distributed.h
  ../csrc/ds4_gpu.h
  ../csrc/ds4_streaming_hotlist.inc
  ../config/core_cflags)
 (action
  (run
   %{cc}
   %{read-lines:../config/core_cflags}
   -DDS4_NO_GPU
   -I
   ../csrc
   -c
   ../csrc/ds4.c
   -o
   ds4_cpu.o)))

(rule
 (target ds4_ssd.o)
 (deps ../csrc/ds4_ssd.c ../csrc/ds4_ssd.h ../config/core_cflags)
 (action
  (run
   %{cc}
   %{read-lines:../config/core_cflags}
   -I
   ../csrc
   -c
   ../csrc/ds4_ssd.c
   -o
   ds4_ssd.o)))

(rule
 (target ds4_distributed.o)
 (deps
  ../csrc/ds4_distributed.c
  ../csrc/ds4_distributed.h
  ../csrc/ds4.h
  ../csrc/ds4_ssd.h
  ../config/core_cflags)
 (action
  (run
   %{cc}
   %{read-lines:../config/core_cflags}
   -I
   ../csrc
   -c
   ../csrc/ds4_distributed.c
   -o
   ds4_distributed.o)))

(rule
 (target libds4_core_cpu.a)
 (deps ds4_cpu.o ds4_ssd.o ds4_distributed.o)
 (action
  (run ar rcs libds4_core_cpu.a ds4_cpu.o ds4_ssd.o ds4_distributed.o)))
