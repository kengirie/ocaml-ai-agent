;; Virtual library: pure OCaml, backend-agnostic. The C FFI stub, the engine
;; archive, and the backend-specific link flags all live in the implementation
;; libraries (../lib_metal, ../lib_cpu), each of which (implements deepseek) and
;; supplies the virtual [Backend] module. A consumer links one implementation;
;; with no explicit choice it gets (default_implementation deepseek_cpu). CPU is
;; the default because it builds everywhere — the Metal implementation is gated
;; to macOS, so it cannot be the portable default. macOS consumers that want
;; Metal depend on [deepseek.metal] explicitly (see ../bin).
;;
;; Dune does not allow foreign_stubs/foreign_archives in a virtual library, so
;; none appear here — that is exactly why the C moves down into the variants.

(library
 (name deepseek)
 (public_name deepseek)
 (modes native)
 (libraries eio unix logs deepseek.dsml)
 (virtual_modules backend)
 (default_implementation deepseek_cpu)
 (modules deepseek v4 agent tool toolbox backend))
