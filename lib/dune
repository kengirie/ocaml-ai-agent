(rule
 (target shaders.ml)
 (deps
  ../gen/gen_shaders.exe
  (glob_files ../csrc/metal/*.metal))
 (action
  (with-stdout-to
   shaders.ml
   (run %{deps}))))

(copy_files ../csrc/libds4_core.a)

(library
 (name deepseek)
 (public_name deepseek)
 (modes native)
 (libraries eio unix)
 (modules v4 shaders)
 (foreign_archives ds4_core)
 (foreign_stubs
  (language c)
  (names ds4_stubs)
  (include_dirs ../csrc))
 (c_library_flags
  (-lm -pthread -framework Foundation -framework Metal)))
