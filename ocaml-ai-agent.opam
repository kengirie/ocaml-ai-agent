# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Capability-confined tools for LLM agents in OCaml"
description:
  "A small tool-using agent for the Anthropic Claude API whose tools are confined by Eio capabilities and described by a typed schema combinator. Cloud-only: no model weights and no native code."
maintainer: ["kengirie"]
authors: ["Anil Madhavapeddy (upstream ocaml-deepseek)" "kengirie"]
license: "ISC"
homepage: "https://github.com/kengirie/ocaml-ai-agent"
bug-reports: "https://github.com/kengirie/ocaml-ai-agent/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "5.2.0"}
  "eio" {>= "1.0"}
  "piaf" {>= "0.2.0"}
  "yojson" {>= "2.0.0"}
  "uri" {>= "4.0.0"}
  "cmdliner" {>= "1.1.0"}
  "fmt" {>= "0.8.7"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/kengirie/ocaml-ai-agent.git"
