;; CPU build of the bin/ program, from the SAME source. The .ml file lives once
;; in ../; here it is copied at build time and linked against [deepseek.cpu]
;; instead of [deepseek.metal]. Result: bin/cpu/humpty.exe — identical code,
;; CPU backend.

(copy_files
 (files ../humpty.ml))

(executable
 (name humpty)
 (public_name humpty-cpu)
 (libraries
  deepseek
  deepseek.cpu
  deepseek.cmd
  deepseek.dsml
  eio
  eio_main
  cmdliner
  logs
  logs.cli
  logs.fmt
  logs.threaded
  fmt
  fmt.cli
  fmt.tty
  xdge
  unix))
