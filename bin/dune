;; The binaries select their inference backend by linking an implementation of
;; the virtual [deepseek] library: [deepseek.metal] here. Because Metal is
;; macOS-only, these executables are gated to macOS; the portable CPU builds of
;; the same programs live in ./cpu and build everywhere.

(executables
 (names ds4_chat ds4_agent)
 (public_names ds4-chat ds4-agent)
 (enabled_if
  (= %{system} macosx))
 (libraries
  deepseek
  deepseek.metal
  deepseek.cmd
  deepseek.dsml
  eio
  eio_main
  cmdliner
  xdge
  unix))
