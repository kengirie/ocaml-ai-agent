;; The binaries select their inference backend by linking an implementation of
;; the virtual [deepseek] library: [deepseek.metal] here. (Listing no
;; implementation would fall back to the library's default_implementation, which
;; is also Metal.) The CPU builds of these same programs live in ./cpu.

(executables
 (names ds4_chat ds4_agent)
 (public_names ds4-chat ds4-agent)
 (libraries
  deepseek
  deepseek.metal
  deepseek.cmd
  deepseek.dsml
  eio
  eio_main
  cmdliner
  xdge
  unix))
