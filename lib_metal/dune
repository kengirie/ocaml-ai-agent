;; Metal backend implementation of the virtual [deepseek] library.
;;
;; Owns everything backend-specific: the engine archive (ds4.c + the Metal
;; backend object ds4_metal.o), a copy of the shared FFI stub, the embedded
;; Metal kernels, and the Foundation/Metal link flags. The core C sources are
;; the vendored ../csrc tree, compiled here the Metal way.
;;
;; Compile flags come from ../config/{core_cflags,objc_cflags}, written by
;; discover.ml, so the native-arch flag is chosen per platform. (Metal itself is
;; macOS-only; gate this library with enabled_if for a Linux build.)

(library
 (name deepseek_metal)
 (public_name deepseek.metal)
 (implements deepseek)
 (modes native)
 (modules backend shaders)
 (private_modules shaders)
 (foreign_archives ds4_core_metal)
 (foreign_stubs
  (language c)
  (names ds4_stubs)
  (include_dirs ../csrc))
 (c_library_flags
  (-lm -pthread -framework Foundation -framework Metal)))

;; The shared, backend-agnostic FFI stub, compiled into this implementation.

(copy_files ../csrc/ds4_stubs.c)

;; Embed the Metal kernels into the generated Shaders module (Backend.sources).

(rule
 (target shaders.ml)
 (deps
  ../gen/gen_shaders.exe
  (glob_files ../csrc/metal/*.metal))
 (action
  (with-stdout-to
   shaders.ml
   (run %{deps}))))

;; --- Engine archive: core (GPU) objects + the Metal backend object. ---

(rule
 (target ds4.o)
 (deps
  ../csrc/ds4.c
  ../csrc/ds4.h
  ../csrc/ds4_ssd.h
  ../csrc/ds4_distributed.h
  ../csrc/ds4_gpu.h
  ../csrc/ds4_streaming_hotlist.inc
  ../config/core_cflags)
 (action
  (run
   %{cc}
   %{read-lines:../config/core_cflags}
   -I
   ../csrc
   -c
   ../csrc/ds4.c
   -o
   ds4.o)))

(rule
 (target ds4_ssd.o)
 (deps ../csrc/ds4_ssd.c ../csrc/ds4_ssd.h ../config/core_cflags)
 (action
  (run
   %{cc}
   %{read-lines:../config/core_cflags}
   -I
   ../csrc
   -c
   ../csrc/ds4_ssd.c
   -o
   ds4_ssd.o)))

(rule
 (target ds4_distributed.o)
 (deps
  ../csrc/ds4_distributed.c
  ../csrc/ds4_distributed.h
  ../csrc/ds4.h
  ../csrc/ds4_ssd.h
  ../config/core_cflags)
 (action
  (run
   %{cc}
   %{read-lines:../config/core_cflags}
   -I
   ../csrc
   -c
   ../csrc/ds4_distributed.c
   -o
   ds4_distributed.o)))

(rule
 (target ds4_metal.o)
 (deps
  ../csrc/ds4_metal.m
  ../csrc/ds4.h
  ../csrc/ds4_gpu.h
  ../csrc/ds4_ssd.h
  (glob_files ../csrc/metal/*.metal)
  ../config/objc_cflags)
 (action
  (run
   %{cc}
   %{read-lines:../config/objc_cflags}
   -I
   ../csrc
   -c
   ../csrc/ds4_metal.m
   -o
   ds4_metal.o)))

(rule
 (target libds4_core_metal.a)
 (deps ds4.o ds4_ssd.o ds4_distributed.o ds4_metal.o)
 (action
  (run
   ar
   rcs
   libds4_core_metal.a
   ds4.o
   ds4_ssd.o
   ds4_distributed.o
   ds4_metal.o)))
