    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/anil.recoil.org/ocaml-deepseek"
x-maintenance-intent: ["(latest)"]
available: (os = "linux" & (arch = "x86_64" | arch = "arm64")) | (os = "macos" & arch = "arm64")
