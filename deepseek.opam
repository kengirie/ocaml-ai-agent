depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2.0"}
  "dune-configurator" {build}
  "jsont" {>= "0.2.0"}
  "xdge" {>= "1.0.0"}
  "eio" {>= "1.0"}
  "logs" {>= "0.7.0"}
  "fmt" {>= "0.8.7"}
  "cmdliner" {>= "1.1.0"}
