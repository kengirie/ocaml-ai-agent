;; Vendored DS4 inference core, specialised for the Metal backend.
;;
;; The four objects below are the complete implementation of the public ds4.h
;; surface (engine, session, tokenizer, sampling, KV payload).  The CLI, server,
;; KV store, help text and linenoise are NOT vendored: they are clients of this
;; boundary, not part of it.  Flags mirror the upstream Makefile (CFLAGS /
;; OBJCFLAGS on Darwin); ds4_metal.m is Objective-C and needs -fobjc-arc.
;;
;; Output is a single static archive libds4_core.a that the OCaml library links
;; via (foreign_archives ds4_core).
;;
;; NOTE: -mcpu=native targets the build machine's CPU (as upstream does for local
;; builds), so the archive/binary is NOT portable across Apple Silicon
;; generations; switch to a baseline (e.g. -mcpu=apple-m1) for distributable
;; artifacts.

(rule
 (target ds4.o)
 (deps
  ds4.c
  ds4.h
  ds4_ssd.h
  ds4_distributed.h
  ds4_gpu.h
  ds4_streaming_hotlist.inc)
 (action
  (run
   %{cc}
   -O3
   -ffast-math
   -g
   -mcpu=native
   -Wall
   -Wextra
   -std=c99
   -I
   .
   -c
   ds4.c
   -o
   ds4.o)))

(rule
 (target ds4_ssd.o)
 (deps ds4_ssd.c ds4_ssd.h)
 (action
  (run
   %{cc}
   -O3
   -ffast-math
   -g
   -mcpu=native
   -Wall
   -Wextra
   -std=c99
   -I
   .
   -c
   ds4_ssd.c
   -o
   ds4_ssd.o)))

(rule
 (target ds4_distributed.o)
 (deps ds4_distributed.c ds4_distributed.h ds4.h ds4_ssd.h)
 (action
  (run
   %{cc}
   -O3
   -ffast-math
   -g
   -mcpu=native
   -Wall
   -Wextra
   -std=c99
   -I
   .
   -c
   ds4_distributed.c
   -o
   ds4_distributed.o)))

(rule
 (target ds4_metal.o)
 (deps ds4_metal.m ds4.h ds4_gpu.h ds4_ssd.h)
 (action
  (run
   %{cc}
   -O3
   -ffast-math
   -g
   -mcpu=native
   -Wall
   -Wextra
   -fobjc-arc
   -I
   .
   -c
   ds4_metal.m
   -o
   ds4_metal.o)))

(rule
 (target libds4_core.a)
 (deps ds4.o ds4_ssd.o ds4_distributed.o ds4_metal.o)
 (action
  (run ar rcs libds4_core.a ds4.o ds4_ssd.o ds4_distributed.o ds4_metal.o)))
