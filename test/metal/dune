; Metal build of the live agent test, from the SAME ../live_agent_mock.ml source
; (mirrors bin/cpu). macOS-only — it links deepseek.metal; on other systems this
; whole directory is inert and only the CPU build in ../ runs. Skips the
; multi-GB model load unless DS4_LIVE is set.
;
; NOTE: this is an (executable), not a (test), on purpose. `enabled_if` on a
; `test` stanza only gates whether the test is *run* (@runtest); the executable
; is still pulled into @all/@default and would fail to link deepseek.metal on
; non-macOS. An (executable) with enabled_if is suppressed entirely off-macOS.
; The (rule (alias runtest)) below restores `dune runtest` coverage on macOS.

(copy_files
 (files ../live_agent_mock.ml))

(executable
 (name live_agent_mock)
 (enabled_if
  (= %{system} macosx))
 (libraries
  deepseek
  deepseek.metal
  deepseek.cmd
  deepseek.dsml
  eio
  eio.mock
  eio_main
  xdge)
 (modules live_agent_mock))

(rule
 (alias runtest)
 (enabled_if
  (= %{system} macosx))
 (action
  (run %{exe:live_agent_mock.exe})))
